# Copy to .env.local for local development. Configure the same keys in Netlify's environment settings.
# Do not commit real secrets or paste them into public chats.
DATABASE_URL=
AUTH_SECRET=
BOOTSTRAP_SECRET=
APP_URL=http://localhost:3000
# Production primary URL: https://velaurlabs.com
# When APP_URL is a VELAUR production domain, the exact custom/www/Netlify aliases
# are accepted for request-origin checks. Other Netlify sites/previews are not trusted.
# Optional; not required for the initial database/authentication flow.
EMAIL_API_KEY=
ANALYTICS_MEASUREMENT_ID=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Optional: verified transactional email via Resend. Never expose these in NEXT_PUBLIC env vars.
RESEND_API_KEY=
VERIFIED_SENDER_EMAIL=

# Required only for media uploads via Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
